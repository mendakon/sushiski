  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "DB ping",
      "description": "直近の SELECT 1 が成功なら UP",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "expr": "sushiski_pg_up",
          "legendFormat": "up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "SELECT 1 直近",
      "description": "使い回し接続でのクエリ往復。Misskey が感じる DB 距離に近い",
