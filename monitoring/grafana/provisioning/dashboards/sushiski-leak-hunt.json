    {
      "type": "timeseries",
      "title": "worker メモリ vs Process / Active（相関）",
      "description": "メモリが Process に比例して上下するなら負荷由来。単調増加ならリーク",
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*bytes.*|.*RSS.*|.*anon.*|.*working.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Process.*|.*active.*|.*rate.*"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "misskey_nodejs_rss_bytes{role=\"worker\"}",
          "legendFormat": "worker RSS",
          "refId": "A"
        },
        {
          "expr": "misskey_nodejs_anon_bytes{role=\"worker\"}",
          "legendFormat": "worker anon≈heap",
          "refId": "B"
        },
        {
          "expr": "container_memory_working_set_bytes{job=\"cadvisor\",name=\"sushiski-web\"}",
          "legendFormat": "web container working set",
          "refId": "C"
        },
        {
          "expr": "misskey_queue_process{queue=\"deliver\"}",
          "legendFormat": "deliver Process",
          "refId": "D"
        },
        {
          "expr": "misskey_queue_jobs{queue=\"deliver\",state=\"active\"}",
          "legendFormat": "deliver active",
          "refId": "E"
        },
        {
          "expr": "misskey_queue_process{queue=\"inbox\"}",
          "legendFormat": "inbox Process",
          "refId": "F"
        }
      ]
    },
